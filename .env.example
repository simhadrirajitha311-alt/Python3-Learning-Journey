# ==============================================================================
# CareerBridge AI - Environment Configuration
# ==============================================================================

# AI Studio runtime auto-injected:
# GEMINI_API_KEY: Required for Gemini AI API calls (Resume analysis, matching, message drafting)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted (auto-injected in AI Studio)
APP_URL="http://localhost:3000"

# --- MongoDB Database Configuration ---
# MONGODB_URI: Connection string for MongoDB Atlas or local MongoDB
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="careerbridge"

# --- Django Backend Configuration ---
# DJANGO_SECRET_KEY: Secret key for Django cryptographic signing (generate via django.core.management.utils.get_random_secret_key)
DJANGO_SECRET_KEY="django-insecure-careerbridge-ai-production-key-change-in-prod"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# --- Application URLs & CORS ---
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# --- Redis & Celery Background Workers ---
# REDIS_URL: Connection URL for Redis message broker and caching
REDIS_URL="redis://localhost:6379/0"

# --- JWT Authentication Settings ---
JWT_ACCESS_TOKEN_LIFETIME="60"     # minutes
JWT_REFRESH_TOKEN_LIFETIME="10080" # 7 days in minutes
JWT_SECRET_KEY="careerbridge-jwt-secure-signing-secret"

# --- Optional OAuth & External Integrations ---
# GITHUB_CLIENT_ID & SECRET: Register at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GOOGLE_CLIENT_ID & SECRET: Register in Google Cloud Console Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# --- Email Notifications (SMTP) ---
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS="True"
DEFAULT_FROM_EMAIL="no-reply@careerbridge.ai"

# --- Cloud Storage (Resumes & Documents) ---
STORAGE_BUCKET="careerbridge-resumes"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

